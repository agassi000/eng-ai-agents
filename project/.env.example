# Copy this file to .env and fill in your values.
# Hugging Face token (needed for push_to_hub and gated datasets). Do NOT commit a real token.
HF_TOKEN=

# RustFS / S3 credentials (defaults match the dev secret in sql/00_attach.sql).
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# COCO ingestion knobs.
COCO_DATASET=detection-datasets/coco
COCO_SPLIT=val
COCO_NUM_IMAGES=200

# VisDrone ingestion knobs (point VISDRONE_DIR at unpacked VisDrone-VID sequences).
VISDRONE_DIR=/data/local/visdrone
VISDRONE_FRAGMENT_FRAMES=30

# Target repo for the gold dataset you push back to the Hub, e.g. your-user/coco-gold.
GOLD_HF_REPO=
